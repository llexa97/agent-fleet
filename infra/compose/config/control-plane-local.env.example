# Développement natif sur loopback uniquement. Ne jamais utiliser en production.
AGENT_FLEET_PRODUCT_NAME=Agent Fleet
AGENT_FLEET_ENVIRONMENT=development
AGENT_FLEET_DATABASE_URL=postgresql+asyncpg://agent_fleet:agent-fleet-dev-password@127.0.0.1:5432/agent_fleet
AGENT_FLEET_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_FLEET_PUBLIC_URL=http://127.0.0.1:8000
AGENT_FLEET_WEB_ORIGIN=http://127.0.0.1:5173
AGENT_FLEET_SESSION_SECRET=local-native-session-secret-change-before-network-use
AGENT_FLEET_BOOTSTRAP_TOKEN=local-native-bootstrap-token-change-before-network-use
AGENT_FLEET_COOKIE_SECURE=false
AGENT_FLEET_TRUSTED_HOSTS=localhost,127.0.0.1
AGENT_FLEET_EMBEDDED_DISPATCHER=false
AGENT_FLEET_LOG_LEVEL=INFO
AGENT_FLEET_LOG_JSON=true
AGENT_FLEET_WORKER_OFFLINE_AFTER_SECONDS=45
AGENT_FLEET_DELIVERY_LEASE_SECONDS=120
AGENT_FLEET_MAX_WS_MESSAGE_BYTES=1048576
AGENT_FLEET_DISPATCHER_POLL_SECONDS=0.5
AGENT_FLEET_MAX_LOGIN_ATTEMPTS_PER_MINUTE=10
AGENT_FLEET_SESSION_TTL_HOURS=24
