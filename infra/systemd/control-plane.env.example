# Fichier systemd, sans `export`. Installer en 0600 root:root.
AGENT_FLEET_PRODUCT_NAME=Agent Fleet
AGENT_FLEET_ENVIRONMENT=production
AGENT_FLEET_DATABASE_URL=postgresql+asyncpg://agent_fleet:ENCODED_PASSWORD@127.0.0.1:5432/agent_fleet
AGENT_FLEET_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_FLEET_PUBLIC_URL=https://agent-fleet.example.net
AGENT_FLEET_WEB_ORIGIN=https://agent-fleet.example.net
AGENT_FLEET_SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
AGENT_FLEET_BOOTSTRAP_TOKEN=REPLACE_WITH_ONE_TIME_RANDOM_BOOTSTRAP_TOKEN
AGENT_FLEET_COOKIE_SECURE=true
AGENT_FLEET_TRUSTED_HOSTS=agent-fleet.example.net,localhost,127.0.0.1
AGENT_FLEET_EMBEDDED_DISPATCHER=false
AGENT_FLEET_LOG_LEVEL=INFO
AGENT_FLEET_LOG_JSON=true
AGENT_FLEET_WORKER_OFFLINE_AFTER_SECONDS=45
AGENT_FLEET_DELIVERY_LEASE_SECONDS=120
AGENT_FLEET_MAX_WS_MESSAGE_BYTES=1048576
AGENT_FLEET_DISPATCHER_POLL_SECONDS=0.5
AGENT_FLEET_MAX_LOGIN_ATTEMPTS_PER_MINUTE=10
AGENT_FLEET_SESSION_TTL_HOURS=24
