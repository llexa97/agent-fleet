[Unit]
Description=Agent Fleet Control Plane
Documentation=file:/opt/agent-fleet/DEPLOYMENT_LXC.md
Requires=postgresql.service redis-server.service caddy.service agent-fleet-api.service agent-fleet-dispatcher.service
After=postgresql.service redis-server.service agent-fleet-api.service agent-fleet-dispatcher.service caddy.service

[Install]
WantedBy=multi-user.target
