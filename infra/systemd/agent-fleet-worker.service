[Unit]
Description=Agent Fleet worker
Documentation=file:/opt/agent-fleet/WORKER_PROTOCOL.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/agent-fleet
EnvironmentFile=/etc/agent-fleet/worker.env
ExecStart=/opt/agent-fleet/.venv/bin/python -m services.worker.main --config /etc/agent-fleet/worker.yaml
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=90s
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=true
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/agent-fleet-worker -/srv/projects
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=1024
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
