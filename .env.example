# Identite du produit (modifiable sans changer le code)
AGENT_FLEET_PRODUCT_NAME=Agent Fleet
AGENT_FLEET_ENVIRONMENT=development

# PostgreSQL est la source de verite. SQLite n'est accepte que pour les tests locaux.
AGENT_FLEET_DATABASE_URL=postgresql+asyncpg://agent_fleet:change-me@postgres:5432/agent_fleet
AGENT_FLEET_REDIS_URL=redis://redis:6379/0
AGENT_FLEET_PUBLIC_URL=http://localhost:8000
AGENT_FLEET_WEB_ORIGIN=http://localhost:5173

# Changez ces valeurs avant toute exposition reseau.
AGENT_FLEET_SESSION_SECRET=replace-with-at-least-32-random-bytes
AGENT_FLEET_BOOTSTRAP_TOKEN=replace-with-one-time-bootstrap-token
AGENT_FLEET_COOKIE_SECURE=false
AGENT_FLEET_TRUSTED_HOSTS=localhost,127.0.0.1

# Execution
AGENT_FLEET_EMBEDDED_DISPATCHER=true
AGENT_FLEET_LOG_LEVEL=INFO
AGENT_FLEET_WORKER_OFFLINE_AFTER_SECONDS=45
AGENT_FLEET_DELIVERY_LEASE_SECONDS=120
AGENT_FLEET_MAX_WS_MESSAGE_BYTES=1048576

# Worker simule de demonstration
AGENT_FLEET_CONTROL_PLANE_WS=ws://localhost:8000/api/v1/workers/connect
AGENT_FLEET_WORKER_ID=a1000000-0000-4000-8000-000000000001
AGENT_FLEET_WORKER_TOKEN=replace-with-worker-token
AGENT_FLEET_WORKER_CONFIG=/etc/agent-fleet/worker.yaml

# Les secrets fournisseurs restent sur le LXC worker, jamais dans le Control Plane.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
